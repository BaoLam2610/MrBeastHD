<resources>

    <style name="transparent_dialog" parent="@android:style/Theme.Holo.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowSoftInputMode">stateHidden</item>
    </style>

    <style name="base_font">
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="base_button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAppearance">@style/bold_14</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_corner_1000</item>
        <item name="android:backgroundTint">@color/button_primary</item>
    </style>

    <!-- Font Weights -->
    <style name="roobert_bold" parent="base_font">
        <item name="android:fontFamily">@font/roobert_bold</item>
    </style>

    <style name="roobert_semibold" parent="base_font">
        <item name="android:fontFamily">@font/roobert_semibold</item>
    </style>

    <style name="roobert_medium" parent="base_font">
        <item name="android:fontFamily">@font/roobert_medium</item>
    </style>

    <style name="roobert_regular" parent="base_font">
        <item name="android:fontFamily">@font/roobert_regular</item>
    </style>

    <!-- Bold Variants -->
    <style name="bold_12" parent="roobert_bold">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="bold_14" parent="roobert_bold">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="bold_18" parent="roobert_bold">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="bold_24" parent="roobert_bold">
        <item name="android:textSize">24sp</item>
    </style>

    <style name="bold_78" parent="roobert_bold">
        <item name="android:textSize">78sp</item>
    </style>

    <!-- Semibold Variants -->
    <style name="semibold_14" parent="roobert_semibold">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="semibold_16" parent="roobert_semibold">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="semibold_18" parent="roobert_semibold">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="semibold_24" parent="roobert_semibold">
        <item name="android:textSize">24sp</item>
    </style>

    <!-- Medium Variants -->
    <style name="medium_12" parent="roobert_medium">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="medium_14" parent="roobert_medium">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="medium_16" parent="roobert_medium">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="medium_18" parent="roobert_medium">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="medium_20" parent="roobert_medium">
        <item name="android:textSize">20sp</item>
    </style>

    <style name="medium_24" parent="roobert_medium">
        <item name="android:textSize">20sp</item>
    </style>

    <!-- Regular Variants -->
    <style name="regular_10" parent="roobert_regular">
        <item name="android:textSize">10sp</item>
    </style>

    <style name="regular_12" parent="roobert_regular">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="regular_14" parent="roobert_regular">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="regular_16" parent="roobert_regular">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="regular_20" parent="roobert_regular">
        <item name="android:textSize">20sp</item>
    </style>
</resources>